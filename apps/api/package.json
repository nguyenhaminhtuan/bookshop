{
  "name": "api",
  "private": true,
  "type": "module",
  "main": "dist/src/main.js",
  "imports": {
    "#*.js": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/src/main.js",
    "dev": "node --watch-path=src --import=@swc-node/register/esm-register --conditions=development --enable-source-maps src/main.ts | pino-pretty --config .pino-prettyrc",
    "test": "node --import=@swc-node/register/esm-register --conditions=development --test \"src/**/*.spec.ts\"",
    "lint": "true",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mikro-orm/core": "7.0.14",
    "@mikro-orm/decorators": "7.0.14",
    "@mikro-orm/nestjs": "7.0.1",
    "@mikro-orm/postgresql": "7.0.14",
    "@nestjs/common": "11.1.19",
    "@nestjs/core": "11.1.19",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/microservices": "11.1.19",
    "@nestjs/platform-express": "11.1.19",
    "jose": "6.2.3",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "4.6.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.19",
    "@swc-node/register": "^1.11.1",
    "@types/express": "^5.0.6",
    "@types/node": "25.6.2",
    "pino-pretty": "13.1.3",
    "rimraf": "catalog:",
    "type-fest": "^5.6.0",
    "typescript": "catalog:"
  }
}
